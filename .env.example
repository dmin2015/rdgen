# ---------------------------------------------------------------------------
# rdgen local configuration template.
#
# Copy this file to ".env" and fill in the values, or run setup_dev.bat which
# generates it for you. The .env file is git-ignored and must never be
# committed - it can contain a GitHub PAT that is able to start builds.
#
# Every value can also be supplied as a real environment variable; the
# environment always takes precedence over this file.
# ---------------------------------------------------------------------------

# GitHub account that owns the rdgen repository (used to start the workflows).
GHUSER=dmin2015

# Repository name within the GitHub account.
REPONAME=rdgen

# Branch whose workflow definitions are dispatched.
GHBRANCH=master

# Personal access token with "workflow" scope on the repository above.
# Create one at: https://github.com/settings/tokens
GHBEARER=github_pat_REPLACE_ME

# Base URL the generated client calls back into (no trailing slash).
GENURL=http://127.0.0.1:8000

# "http" or "https" - the scheme used for GENURL.
PROTOCOL=http

# Password of the encrypted secrets zip. Must match the ZIP_PASSWORD secret
# configured in the GitHub repository, otherwise the CI cannot decrypt it.
ZIP_PASSWORD=insecure

# Shared secret typed into the web form to mark a build as self-hosted.
SH_SECRET=secret

# Address and port of the local development server.
RDGEN_HOST=127.0.0.1
RDGEN_PORT=8000
