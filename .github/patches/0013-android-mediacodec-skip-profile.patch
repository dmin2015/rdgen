+// rdgen: the MediaCodec encoders that refuse to be configured when the
+// MediaFormat carries an explicit profile or level.
+//
+// The Rockchip AVC encoder (OMX.rk.video_encoder.avc) used by the RK3566
+// and other Rockchip boxes rejects every profile value and makes
+// configure() fail with OMX_ErrorBadParameter. Only the vendor prefix is
+// matched, so a device that exposes the encoder under a different name is
+// not affected.
+static int ff_AMediaCodec_refuses_profile(const char *name)
+{
+    static const char *const prefixes[] = {
+        "OMX.rk.",
+        "c2.rk.",
+    };
+
+    if (!name)
+        return 0;
+
+    for (size_t i = 0; i < FF_ARRAY_ELEMS(prefixes); i++)
+        if (av_strstart(name, prefixes[i], NULL))
+            return 1;
+
+    return 0;
+}
