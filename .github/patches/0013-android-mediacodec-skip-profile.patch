+    // rdgen: do not write an explicit profile/level into the MediaFormat of
+    // the encoders that are known to refuse them.
+    //
+    // The Rockchip AVC encoder (OMX.rk.video_encoder.avc) on the very common
+    // RK3566 boxes rejects *every* explicit profile and fails the whole
+    // configure() call with OMX_ErrorBadParameter (-38). ffmpeg always
+    // writes the profile because the hwcodec crate hardcodes
+    // FF_PROFILE_H264_HIGH, so the key cannot be avoided by the caller.
+    // RustDesk then gives up on H.26x, falls back to VP8 and halves the
+    // capture resolution - that is what makes the remote picture blurry.
+    //
+    // The profile and the level are only hints: when they are absent the
+    // encoder picks its own defaults. Verified on a RK3566 with a
+    // MediaCodec probe: the Rockchip encoder produces real H.264 frames
+    // (SPS/PPS included) at 1366x768 and 1408x768 when no profile is set,
+    // and fails to configure when any profile value is set.
+    if (!ff_AMediaCodec_refuses_profile(s->name)) {
+        ret = ff_AMediaCodecProfile_getProfileFromAVCodecContext(avctx);
+        if (ret > 0) {
+            av_log(avctx, AV_LOG_DEBUG, "set profile to 0x%x\n", ret);
+            ff_AMediaFormat_setInt32(format, "profile", ret);
+        }
+        if (s->level > 0) {
+            av_log(avctx, AV_LOG_DEBUG, "set level to 0x%x\n", s->level);
+            ff_AMediaFormat_setInt32(format, "level", s->level);
+        }
+    } else {
+        av_log(avctx, AV_LOG_DEBUG,
+               "skipping the profile/level keys for the encoder %s\n",
+               s->name ? s->name : "(by mime)");
