diff --git a/libavcodec/mediacodecenc.c b/libavcodec/mediacodecenc.c
index c336c3b..8875a62 100644
--- a/libavcodec/mediacodecenc.c
+++ b/libavcodec/mediacodecenc.c
@@ -263,7 +263,16 @@ static av_cold int mediacodec_init(AVCodecContext *avctx)
     ff_AMediaFormat_setString(format, "mime", codec_mime);
     // Workaround the alignment requirement of mediacodec. We can't do it
     // silently for AV_PIX_FMT_MEDIACODEC.
-    const int align = 64;
+    // rdgen: the Rockchip encoder accepts the exact frame size, so aligning it
+    // only makes ffmpeg install the h264_metadata bitstream filter to crop the
+    // picture back. That filter has to parse and rewrite the SPS, and the
+    // Rockchip SPS (log2_max_pic_order_cnt_lsb_minus4 = 13) does not survive
+    // the parse, so every frame fails and RustDesk falls back to blurry VP8.
+    // Without a crop no filter is installed and the packets pass through.
+    int align = 64;
+    if (s->name && (av_strstart(s->name, "OMX.rk.", NULL) ||
+                    av_strstart(s->name, "c2.rk.", NULL)))
+        align = 2;
     if (avctx->pix_fmt != AV_PIX_FMT_MEDIACODEC &&
         (avctx->codec_id == AV_CODEC_ID_H264 ||
          avctx->codec_id == AV_CODEC_ID_HEVC)) {
