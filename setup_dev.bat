@echo off
REM ---------------------------------------------------------------------------
REM rdgen first-run configuration wizard.
REM
REM Creates the local ".env" file that holds the GitHub PAT and the other
REM settings. The .env file is git-ignored and is never committed.
REM Run start_dev.bat afterwards to launch the server.
REM ---------------------------------------------------------------------------
setlocal enabledelayedexpansion
cd /d "%~dp0"

if exist ".env" (
  echo.
  echo [rdgen] .env already exists.
  set /p OVERWRITE="Overwrite it with fresh values? [y/N]: "
  if /i not "!OVERWRITE!"=="y" (
    echo [rdgen] keeping the existing .env - nothing changed.
    goto :done
  )
)

echo.
echo === rdgen setup ===
echo.
echo Press Enter to accept the default in brackets.

set "GHUSER="
set /p "GHUSER=GitHub account that owns the repo [dmin2015]: "
if "!GHUSER!"=="" set "GHUSER=dmin2015"

set "REPONAME="
set /p "REPONAME=Repository name [rdgen]: "
if "!REPONAME!"=="" set "REPONAME=rdgen"

set "GHBRANCH="
set /p "GHBRANCH=Branch to build from [master]: "
if "!GHBRANCH!"=="" set "GHBRANCH=master"

echo.
echo The GitHub PAT needs the "workflow" scope on the repository above.
echo Create one at: https://github.com/settings/tokens
set "GHBEARER="
set /p "GHBEARER=GitHub PAT (leave empty to fill in later): "

set "GENURL="
set /p "GENURL=Base URL for the generated client [http://127.0.0.1:8000]: "
if "!GENURL!"=="" set "GENURL=http://127.0.0.1:8000"

set "PROTOCOL="
set /p "PROTOCOL=Scheme for that URL - http or https [http]: "
if "!PROTOCOL!"=="" set "PROTOCOL=http"

set "ZIP_PASSWORD="
set /p "ZIP_PASSWORD=Secrets zip password (must match the GitHub ZIP_PASSWORD secret) [insecure]: "
if "!ZIP_PASSWORD!"=="" set "ZIP_PASSWORD=insecure"

set "RDGEN_PORT="
set /p "RDGEN_PORT=Local server port [8000]: "
if "!RDGEN_PORT!"=="" set "RDGEN_PORT=8000"

REM ---- write .env ----
(
  echo # Generated by setup_dev.bat - never commit this file.
  echo GHUSER=!GHUSER!
  echo REPONAME=!REPONAME!
  echo GHBRANCH=!GHBRANCH!
  echo GHBEARER=!GHBEARER!
  echo GENURL=!GENURL!
  echo PROTOCOL=!PROTOCOL!
  echo ZIP_PASSWORD=!ZIP_PASSWORD!
  echo RDGEN_HOST=127.0.0.1
  echo RDGEN_PORT=!RDGEN_PORT!
) > ".env"

REM ---- restrict access to the current user only ----
icacls ".env" /inheritance:r /grant:r "%USERNAME%:(R,W)" >nul 2>&1
icacls ".env" /grant:r "%USERNAME%:F" >nul 2>&1

echo.
echo [rdgen] wrote .env ^(PAT kept out of this script and out of git^).
if "!GHBEARER!"=="" (
  echo [rdgen] NOTE: GHBEARER is empty - edit .env before starting a build.
)
echo [rdgen] next: run start_dev.bat

:done
echo.
pause
